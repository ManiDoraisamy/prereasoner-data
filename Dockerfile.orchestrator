# The Sonnet orchestrator + the Prereasoner MCP server (docs/MCP.md).
#
# One lean image: the orchestrator HTTP server spawns the MCP server as a stdio subprocess (same image),
# and the MCP server calls the engine over HTTP (ENGINE_BASE_URL). NO torch/transformers/spaCy here — the
# heavy model image is the separate engine Dockerfile. This container only needs anthropic + mcp + httpx.
#
# Build:  docker build -f Dockerfile.orchestrator -t prereasoner-chat .
# Run:    docker run -p 8090:8090 -e ANTHROPIC_API_KEY=... -e ENGINE_BASE_URL=https://<engine-url> prereasoner-chat
FROM python:3.11-slim@sha256:be1575ed968de893bd54f4c56315ff7c4736ce522c1bca08fd521731aafc0d76

WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1

COPY LICENSE THIRD_PARTY.md /licenses/
COPY orchestrator/requirements.lock.txt /app/orchestrator/requirements.lock.txt
RUN pip install --no-cache-dir --require-hashes -r orchestrator/requirements.lock.txt

# The orchestrator uses only engine.config plus the lightweight auth and trace modules imported by /chat.
# Copy those modules explicitly so local model weights and the heavy serving implementation cannot accidentally
# inflate this lean image.
# mcp_server/ + orchestrator/ are the app. web/ is NOT copied: in production Firebase Hosting serves the
# static UI and rewrites only /chat + /api to this service, so the container never serves static files
# (and web/ is excluded from the build upload by .gcloudignore). Local dev serves web/ from the repo tree.
RUN mkdir -p /app/engine
# model_revisions is a constants-only module engine.config imports at module load; omitting it is a
# BOOT failure (ModuleNotFoundError at container start), which the build's test step cannot catch
# because it runs from the full repo tree, not from this image.
COPY engine/__init__.py engine/config.py engine/auth.py engine/trace.py engine/request_limits.py engine/model_revisions.py /app/engine/
COPY mcp_server/ /app/mcp_server/
COPY orchestrator/ /app/orchestrator/

# Validate the exact final image, including its installed dependency set and stdio child process.
RUN python -m mcp_server.healthcheck

# Cloud Run injects PORT; the orchestrator binds ORCH_PORT. Map them so the container obeys Cloud Run.
ENV ORCH_HOST=0.0.0.0 ORCH_PORT=8090
EXPOSE 8090

# ORCH_PORT falls back to $PORT when Cloud Run sets it (see CMD). ENGINE_BASE_URL must be provided.
CMD ["sh", "-c", "ORCH_PORT=${PORT:-8090} python -m orchestrator.server"]
