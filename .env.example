# PreReasoner configuration
# Copy to .env and fill in. .env is gitignored — never commit real values.

# ---------- Serving (Cloud Run / local) ----------
HOST=0.0.0.0
PORT=8080

# World knowledge database (Postgres with pgvector).
# Local dev: docker-compose provides this at localhost:5432.
# GCP: set to the Cloud SQL instance created by infra/ (private IP or connector).
WORLD_PG_HOST=localhost
WORLD_PG_PORT=5432
WORLD_PG_DB=world
WORLD_PG_USER=postgres
WORLD_PG_PASSWORD=
# libpq sslmode for TCP connections: prefer (default, works with docker-compose) or require (Cloud SQL public IP).
# WORLD_PG_SSLMODE=prefer

# Firebase Realtime Database for live reasoning-trace streaming.
# Optional: leave empty to disable streaming (responses still return full JSON).
RTDB_URL=

# Firebase Auth: /api/reason and /api/world verify a Firebase ID token.
# For local dev/tests only, bypass verification with a fixed principal:
# AUTH_TEST_SUB=localdev

# Model/data directory (encoder weights, embeddings, taxonomy).
# Defaults to engine/data inside the repo.
# PREREASONER_DATA_DIR=
# PREREASONER_SQL_PLANNER=legacy
# PREREASONER_SQL_PROPOSER=
# PREREASONER_SQL_RANKER=

# Torch device for the encoder: cpu (default, Cloud Run) or cuda (local GPU).
DEVICE=cpu

# Hugging Face id of the base encoder LM (rarely changed).
# BASE_MODEL_ID=Qwen/Qwen2.5-0.5B

# Set to 0 to disable model-driven column routing (falls back to value-membership routing).
# WORLD_MODEL_ROUTE=1

# ---------- MCP layer: Sonnet orchestrator + PreReasoner MCP server (mcp-now.md) ----------
# The chat backend that calls PreReasoner as an MCP tool. Needed to run orchestrator/ + mcp_server/.
# ANTHROPIC_API_KEY is REQUIRED for the orchestrator; the orchestrator/tests load this .env locally.
ANTHROPIC_API_KEY=
# Sonnet model id for the orchestrator (a Sonnet, per the design).
ANTHROPIC_MODEL=claude-sonnet-5
# Where the MCP server reaches the engine over HTTP. Local: http://127.0.0.1:8080;
# docker-compose: http://engine:8080; prod: the engine's Cloud Run URL.
# ENGINE_BASE_URL=http://127.0.0.1:8080
# Orchestrator chat server bind (local dev / container).
# ORCH_HOST=0.0.0.0
# ORCH_PORT=8090

# ---------- Training / reproduction (GPU, not needed for serving) ----------
# Hugging Face token for pulling the Qwen2.5-0.5B base model.
HF_TOKEN=
# RunPod API key if reproducing training on RunPod GPUs (see training/README.md).
RUNPOD_API_KEY=
