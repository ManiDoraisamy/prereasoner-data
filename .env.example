# PreReasoner configuration
# Copy to .env and fill in. .env is gitignored — never commit real values.

# ---------- Serving (Cloud Run / local) ----------
HOST=0.0.0.0
PORT=8080
APP_ENV=development
# Exact browser origins allowed to call the API. Leave empty for same-origin production hosting.
CORS_ORIGINS=http://localhost:8090,http://127.0.0.1:8090

# Postgres world and source schemas (Wikidata entities, publisher releases, pgvector).
# Local dev: docker-compose provides this at localhost:5432.
# GCP: set to the Cloud SQL instance created by infra/ (private IP or connector).
KB_PG_HOST=localhost
KB_PG_PORT=5432
KB_PG_DB=world
KB_PG_USER=postgres
KB_PG_PASSWORD=
# libpq sslmode for TCP connections: prefer (default, works with docker-compose) or require (Cloud SQL public IP).
# KB_PG_SSLMODE=prefer

# Comma-separated, code-approved deterministic reference datasets. Empty keeps enrichment off.
# ENRICHMENT_ACTIVE_DATASETS=iana_country

# Privileged credentials are for offline source sync, migrations, release rollback, and grants only.
# Production should set these on sync jobs and use a separate non-superuser KB_PG_USER for serving.
# SYNC_PG_USER=postgres
# SYNC_PG_PASSWORD=

# Firebase Realtime Database for live reasoning-trace streaming.
# Optional: leave empty to disable streaming (responses still return full JSON).
RTDB_URL=
# Expired traces are removed by the scheduled cleanup job (default 7 days, bounded 1..365).
RTDB_TRACE_RETENTION_DAYS=7

# Firebase Auth: /api/reason and /api/knowledge verify a Firebase ID token.
# For local dev/tests only (APP_ENV=development or test), bypass verification with a fixed principal:
# AUTH_TEST_SUB=localdev
# Admin API access is disabled unless this explicit email allowlist is configured.
# ADMIN_EMAILS=admin@example.com

# Model/data directory (encoder weights, embeddings, taxonomy).
# Defaults to engine/data inside the repo.
# PREREASONER_DATA_DIR=

# Torch device for the encoder: cpu (default, Cloud Run) or cuda (local GPU).
DEVICE=cpu

# Hugging Face id of the base encoder LM (rarely changed).
# BASE_MODEL_ID=Qwen/Qwen2.5-0.5B

# Set to 0 to disable model-driven column routing (falls back to value-membership routing).
# KB_MODEL_ROUTE=1

# ---------- MCP layer: Sonnet orchestrator + PreReasoner MCP server (docs/MCP.md) ----------
# The chat backend that calls PreReasoner as an MCP tool. Needed to run orchestrator/ + mcp_server/.
# External LLM egress is disabled unless this deployment flag is true. Publish /privacy and review
# the deployed processor/data-flow contract before enabling it.
EXTERNAL_LLM_ENABLED=false
# ANTHROPIC_API_KEY is used only by the deployment-enabled external LLM paths.
ANTHROPIC_API_KEY=
# Sonnet model id for the orchestrator (a Sonnet, per the design).
ANTHROPIC_MODEL=claude-sonnet-5
# Where the MCP server reaches the engine over HTTP. Local: http://127.0.0.1:8080;
# docker-compose: http://engine:8080; prod: the engine's Cloud Run URL.
# ENGINE_BASE_URL=http://127.0.0.1:8080
# Orchestrator chat server bind (local dev / container).
# ORCH_HOST=0.0.0.0
# ORCH_PORT=8090

# ---------- Training / reproduction (GPU, not needed for serving) ----------
# Optional Hugging Face token for authenticated downloads or a private repository override.
# The default PreReasoner weights and Qwen2.5-0.5B base model are public.
HF_TOKEN=
# RunPod API key if reproducing training on RunPod GPUs (see training/README.md).
RUNPOD_API_KEY=
