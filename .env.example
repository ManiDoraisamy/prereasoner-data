# Prereasoner configuration
# Copy to .env and fill in. .env is gitignored — never commit real values.

# ---------- Serving (Cloud Run / local) ----------
HOST=0.0.0.0
PORT=8080
APP_ENV=development
# Exact browser origins allowed to call the API. Leave empty for same-origin production hosting.
CORS_ORIGINS=http://localhost:8090,http://127.0.0.1:8090

# Postgres world and source schemas (Wikidata entities, publisher releases, pgvector).
# Local dev: docker-compose provides this at localhost:5432.
# GCP: set to the Cloud SQL instance created by infra/ (private IP or connector).
KB_PG_HOST=localhost
KB_PG_PORT=5432
KB_PG_DB=world
KB_PG_USER=postgres
KB_PG_PASSWORD=
# libpq sslmode for TCP connections: prefer (default, works with docker-compose) or require (Cloud SQL public IP).
# KB_PG_SSLMODE=prefer

# Comma-separated, code-approved deterministic reference datasets. Empty keeps enrichment off.
# ENRICHMENT_ACTIVE_DATASETS=iana_country

# Privileged credentials are for offline source sync, migrations, release rollback, and grants only.
# Production should set these on sync jobs and use a separate non-superuser KB_PG_USER for serving.
# SYNC_PG_USER=postgres
# SYNC_PG_PASSWORD=

# Firebase Realtime Database for live reasoning-trace streaming.
# Optional: leave empty to disable streaming (responses still return full JSON).
RTDB_URL=
# Expired traces are removed by the scheduled cleanup job (default 7 days, bounded 1..365).
RTDB_TRACE_RETENTION_DAYS=7

# Firebase Auth: /api/reason and /api/knowledge verify a Firebase ID token.
# For local dev/tests only (APP_ENV=development or test), bypass verification with a fixed principal:
# AUTH_TEST_SUB=localdev
# Admin API access is disabled unless this explicit email allowlist is configured.
# ADMIN_EMAILS=admin@example.com

# Model/data directory (encoder weights, embeddings, taxonomy).
# Defaults to engine/data inside the repo.
# PREREASONER_DATA_DIR=

# Torch device for the encoder: cpu (default, Cloud Run) or cuda (local GPU).
DEVICE=cpu

# Hugging Face id of the base encoder LM (rarely changed).
# BASE_MODEL_ID=Qwen/Qwen2.5-0.5B

# Set to 0 to disable model-driven column routing (falls back to value-membership routing).
# KB_MODEL_ROUTE=1

# Every supported direct or named analysis uses Python for bounded small inputs and SQL for larger inputs.
# Request-local use=sql|py|both overrides this policy, including direct requests. Explicit py/both
# reject unsupported query results; the environment default alone does not disable SQL fallback.
# Auto also falls back to SQL if the hard materialization limit or Python runtime fails. Use verify
# to execute both and reject a mismatch. Development writes the exact emitted Python to
# engine/deterministic/_gen; production remains memory-only unless persistence is explicitly enabled.
DETERMINISTIC_EXECUTION_MODE=auto
DETERMINISTIC_PYTHON_ROW_LIMIT=10000
DETERMINISTIC_PERSIST_GENERATED=false

# ---------- Gemini (engine/llm.py) + the chat orchestrator (docs/MCP.md) ----------
# Gemini is the one external model, and it is always on: the chat assistant, starter questions and
# reference generation run on Vertex AI, and the engine's own-data closed choices run on the Gemini
# Developer API's Decisions endpoint. Publish /privacy and review the deployed processor/data-flow
# contract (PRIVACY.md) before a hosted deployment.
# The Google Cloud project whose Vertex AI serves Gemini (enable the Vertex AI API there). Credentials
# are Application Default Credentials: run `gcloud auth application-default login` once.
GOOGLE_CLOUD_PROJECT=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_LOCATION=global
# The Gemini Developer API key the engine's Decisions calls send (a key restricted to the Generative
# Language API in a project with billing). A deployment reads it from Secret Manager; never commit it.
GOOGLE_API_KEY=
# DECISIONS_MODEL=gemini-decision-1
# The gcloud configuration directory (it holds the ADC file) docker compose mounts read-only into its
# containers. The default is the macOS/Linux location; on Windows use %APPDATA%\gcloud.
# GCLOUD_CONFIG_DIR=~/.config/gcloud
# Shared by the local engine and orchestrator. Production Terraform creates and injects this secret.
# DATASET_ATTESTATION_KEY=replace-with-a-long-random-local-value
# Where the MCP server reaches the engine over HTTP. Local: http://127.0.0.1:8080;
# docker-compose: http://engine:8080; prod: the engine's Cloud Run URL.
# ENGINE_BASE_URL=http://127.0.0.1:8080
# Orchestrator chat server bind (local dev / container).
# ORCH_HOST=0.0.0.0
# ORCH_PORT=8090

# ---------- Evaluation (regress/eval_sets.py, run_dev_decisions.py, run_public.py) ----------
# Where `python -m regress.eval_sets fetch` puts the public datasets (default ~/.cache/prereasoner/datasets).
PREREASONER_DATASETS=
# A folder holding a copy of a stock backbone by its name (bge-m3/, the pinned revision's files); without one the pinned
# hub revision is read from the local Hugging Face cache, and NAMED_BACKBONE_ONLINE=1 downloads it.
NAMED_BACKBONE_DIR=

# ---------- Training / reproduction (GPU, not needed for serving) ----------
# Optional Hugging Face token for authenticated downloads or a private repository override.
# The default Prereasoner weights and Qwen2.5-0.5B base model are public.
HF_TOKEN=
# RunPod API key if reproducing training on RunPod GPUs (see training/README.md).
RUNPOD_API_KEY=
