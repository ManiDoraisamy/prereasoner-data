{
  "hosting": {
    "public": "public",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/chat",
        "run": { "serviceId": "prereasoner-chat", "region": "us-central1" }
      },
      {
        "source": "/api/**",
        "run": { "serviceId": "prereasoner-api", "region": "us-central1" }
      },
      { "source": "/reason/**", "destination": "/reason.html" },
      { "source": "/knowledge/**", "destination": "/knowledge.html" },
      { "source": "/sheets", "destination": "/index.html" },
      { "source": "/excel", "destination": "/index.html" },
      { "source": "/csv", "destination": "/index.html" }
    ],
    "redirects": [
      { "source": "/world", "destination": "/knowledge", "type": 301 },
      { "source": "/world/**", "destination": "/knowledge", "type": 301 },
      { "source": "/sheet", "destination": "/sheets", "type": 301 },
      { "source": "/CSV", "destination": "/csv", "type": 301 }
    ],
    "headers": [
      {
        "source": "**/*.@(html|css|svg|js)",
        "headers": [ { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" } ]
      },
      {
        "comment": "cleanUrls serves pages EXTENSIONLESS (/sheets, /reason), which the glob above cannot match — they were being cached for an hour, so a deploy looked like it had not landed.",
        "source": "**/!(*.*)",
        "headers": [ { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" } ]
      },
      {
        "comment": "The root's final path segment is EMPTY, so whether !(*.*) above covers it depends on the glob matcher's version. Live Hosting does send no-cache for /, but state it outright rather than rest on that.",
        "source": "/",
        "headers": [ { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" } ]
      },
      {
        "source": "**",
        "headers": [
          { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
        ]
      }
    ]
  },
  "database": {
    "rules": "database.rules.json"
  },
  "emulators": {
    "hosting": { "port": 5000 },
    "auth": { "port": 9099 },
    "database": { "port": 9000 },
    "ui": { "enabled": true }
  }
}
