# Secrets & local config — never commit
.env
*.tfvars
service-account*.json

# Python
__pycache__/
*.py[cod]
venv/
.venv/
*.egg-info/

# Large model/data artifacts (fetched via scripts — see engine/data/README.md)
engine/data/*.pt
engine/data/*.db
engine/data/*.npz
engine/data/qwen_lora/
!engine/data/README.md

# training/props pipeline scratch — generated corpus + weights (rebuild via training/props/pipeline.md)
training/props/data/*
!training/props/data/.gitkeep

# Logs & local state
*.log
.firebase/
firebase-debug.log
.claude/
spider/results/**/*.checkpoint.json

# Terraform
infra/**/.terraform/
infra/**/*.tfstate
infra/**/*.tfstate.backup
infra/**/*.tfplan
infra/**/*.tfplan.*
infra/$plan
!infra/.terraform.lock.hcl

# Node / tooling
node_modules/

# OS
Thumbs.db
.DS_Store
.model_taxbak/

# Opted-in evaluation metadata stays local; only validators and public fixtures are committed.
regress/private/
